# Empty means same-origin requests in production and Vite proxy in development.
VITE_API_BASE_URL=

# Optional admin bearer token used automatically by the web client.
# This value is exposed to the browser bundle; use only in a trusted LAN deployment.
VITE_ADMIN_TOKEN=

# Only used by Vite's local development proxy.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
