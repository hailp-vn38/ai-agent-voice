{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "collect_topic result",
  "type": "object",
  "properties": {
    "source_id": {
      "const": "fixture"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "title",
          "text",
          "published_at",
          "synthetic"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_id": {
            "const": "fixture"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "synthetic": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": "null"
    },
    "done": {
      "const": true
    },
    "synthetic": {
      "const": true
    },
    "provenance": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "const": "fixture"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "fixture.collect",
                "research.collect"
              ]
            },
            "maxItems": 2
          },
          "records": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          }
        },
        "required": [
          "source",
          "capabilities",
          "records"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source_id",
    "topic",
    "record_count",
    "summary",
    "records",
    "next_cursor",
    "done",
    "synthetic",
    "provenance"
  ],
  "additionalProperties": false
}
