[
  {
    "name": "offline HTML content and metadata",
    "operation": "extract_html",
    "arguments": {
      "html": "<html><head><title>Example</title></head><body><main><nav><p>Ignore navigation</p></nav><h1>Hello</h1><p>World<script>Ignore script</script></p><a href='/more'>More</a></main></body></html>",
      "url": "https://example.com/"
    },
    "expected": {
      "/title": "Example",
      "/text": "Hello\nWorld",
      "/word_count": 2,
      "/links/0/url": "https://example.com/more",
      "/truncated": false
    },
    "expected_artifacts": 2
  },
  {
    "name": "private IP rejected",
    "operation": "fetch_url",
    "arguments": {
      "url": "http://127.0.0.1/secret"
    },
    "expected_error": "invalid_url",
    "expected_artifacts": 0
  },
  {
    "name": "unavailable network fails cleanly",
    "operation": "fetch_url",
    "arguments": {
      "url": "https://example.com/"
    },
    "expected_error": "fetch_failed",
    "expected_artifacts": 0
  }
]
