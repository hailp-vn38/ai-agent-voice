[
  {
    "name": "Markdown text headings and statistics",
    "operation": "analyze_document",
    "arguments": {
      "format": "markdown",
      "text": "# Rust report\n\nRust makes documents useful."
    },
    "expected": {
      "/title": "Rust report",
      "/format": "markdown",
      "/headings/0": "Rust report",
      "/word_count": 6,
      "/truncated": false
    },
    "expected_artifacts": 2
  },
  {
    "name": "malformed PDF returns application error",
    "operation": "analyze_document",
    "arguments": {
      "format": "pdf",
      "content_base64": "bm90LWEtcGRm"
    },
    "expected_error": "invalid_pdf",
    "expected_artifacts": 0
  },
  {
    "name": "malformed DOCX returns application error",
    "operation": "analyze_document",
    "arguments": {
      "format": "docx",
      "content_base64": "bm90LWEtemlw"
    },
    "expected_error": "invalid_docx",
    "expected_artifacts": 0
  },
  {
    "name": "selectable PDF text and artifacts",
    "operation": "analyze_document",
    "arguments": {
      "format": "pdf",
      "content_base64": ""
    },
    "expected": {
      "/text": "Hello PDF",
      "/page_count": 1
    },
    "expected_artifacts": 2
  },
  {
    "name": "selectable DOCX text and artifacts",
    "operation": "analyze_document",
    "arguments": {
      "format": "docx",
      "content_base64": ""
    },
    "expected": {
      "/text": "Hello DOCX",
      "/page_count": null
    },
    "expected_artifacts": 2
  }
]
