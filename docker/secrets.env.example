# Supply master keys from the deployment secret manager; never store them in SQLite.
# Generate a random 32-byte key and encode it as Base64.
VOICE_CREDENTIAL_KEY_VERSION=1
# VOICE_CREDENTIAL_KEY_1=<base64-encoded-32-byte-key>
# Keep old VOICE_CREDENTIAL_KEY_<version> variables until old records are replaced.
# Existing per-resource VOICE_PROVIDER_*_API_KEY and VOICE_MCP_*_TOKEN remain fallback sources.

# Device Push Channel (profile `push`): derives every Device and broker-service password.
# Changing it invalidates all existing Device passwords. Required when [device_push].enabled.
# VOICE_DEVICE_PUSH_SECRET=<random-string>
